import numpy as np
import matplotlib.pyplot as plt
from matplotlib.animation import FuncAnimation, PillowWriter
import matplotlib.patches as patches

# Simple animated visualization of Hoberman-style spherical scissor lattice with fluctuations
fig, ax = plt.subplots(figsize=(10, 8))
ax.set_xlim(-1.5, 1.5)
ax.set_ylim(-1.5, 1.5)
ax.set_aspect('equal')
ax.set_title('ℳ Hoberman Spherical Scissor Lattice + Fluctuations\nPossibility Cloud Theory')
ax.grid(True, alpha=0.3)

# Central sphere representation
sphere = plt.Circle((0, 0), 1.0, fill=False, color='blue', linewidth=2, alpha=0.7)
ax.add_patch(sphere)

# Scissor linkages (simplified as lines)
lines = []
for i in range(12):
    theta = i * np.pi / 6
    line, = ax.plot([0, np.cos(theta)], [0, np.sin(theta)], 'r-', linewidth=1.5, alpha=0.6)
    lines.append(line)

# Fluctuation "pebbles"
fluctuations = []
for _ in range(8):
    f = ax.scatter([], [], c='yellow', s=50, alpha=0.8)
    fluctuations.append(f)

def animate(frame):
    # Animate scissor expansion/contraction
    scale = 1.0 + 0.3 * np.sin(frame / 10)
    for i, line in enumerate(lines):
        theta = i * np.pi / 6 + frame / 50
        line.set_data([0, scale * np.cos(theta)], [0, scale * np.sin(theta)])
    
    # Animate fluctuations
    for i, f in enumerate(fluctuations):
        r = 0.8 + 0.4 * np.sin(frame / 8 + i)
        theta = frame / 15 + i
        f.set_offsets([[r * np.cos(theta), r * np.sin(theta)]])
        f.set_alpha(0.6 + 0.4 * np.sin(frame / 5 + i))
    
    return lines
